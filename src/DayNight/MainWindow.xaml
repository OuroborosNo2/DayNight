<Window x:Class="DayNight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="昼夜 DayNight"
        Height="700" Width="920"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="210"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="20" Padding="16" Margin="0,0,14,0"
            BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
      <DockPanel>
        <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" VerticalAlignment="Bottom"
                   Foreground="{DynamicResource Muted}" FontSize="11" Margin="6,8,0,4"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="2,2,2,14">
              <Border Width="40" Height="40" CornerRadius="14" Margin="0,0,10,0" ClipToBounds="True">
                <Image Source="pack://application:,,,/Assets/preview.png" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="昼夜" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <TextBlock x:Name="TitleEnText" Text="DayNight" Foreground="{DynamicResource Muted}" FontSize="11"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="TaglineText" Style="{StaticResource Hint}" Margin="2,0,2,10"/>
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="10,8" Margin="0,0,0,14">
              <TextBlock x:Name="LiteBadge" Foreground="{DynamicResource Text}" TextWrapping="Wrap" FontSize="11.5" LineHeight="18"/>
            </Border>
            <RadioButton x:Name="NavSchedule" Style="{StaticResource NavBtn}" Content="时间表" IsChecked="True" Checked="Nav_OnChecked"/>
            <RadioButton x:Name="NavTheme" Style="{StaticResource NavBtn}" Content="外观" Checked="Nav_OnChecked"/>
            <RadioButton x:Name="NavDisplay" Style="{StaticResource NavBtn}" Content="显示" Checked="Nav_OnChecked"/>
            <RadioButton x:Name="NavGeneral" Style="{StaticResource NavBtn}" Content="设置" Checked="Nav_OnChecked"/>
            <RadioButton x:Name="NavAbout" Style="{StaticResource NavBtn}" Content="关于" Checked="Nav_OnChecked"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border x:Name="ContentBorder" Grid.Column="1" Background="{DynamicResource Panel}" CornerRadius="20" Padding="20"
            BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
          <Button x:Name="SaveButton" Content="保存并应用" HorizontalAlignment="Right" Click="Save_OnClick"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel x:Name="PageSchedule">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="ManualTitle" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="ManualHint" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ManualLight" Margin="0,0,10,0" MinWidth="132"
                            AutomationProperties.AutomationId="BtnManualLight"
                            Click="ManualLight_OnClick"/>
                    <Button x:Name="ManualDark" Style="{StaticResource GhostButton}" MinWidth="132"
                            AutomationProperties.AutomationId="BtnManualDark"
                            Click="ManualDark_OnClick"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="ScheduleTitle" Style="{StaticResource SectionTitle}"/>
                  <CheckBox x:Name="ScheduleEnabled"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="170"/>
                      <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LightAtLabel" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                    <TextBox x:Name="LightAtBox" Grid.Column="1" Margin="0,4"/>
                    <TextBlock x:Name="DarkAtLabel" Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                    <TextBox x:Name="DarkAtBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                  </Grid>
                  <TextBlock x:Name="ScheduleHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PageTheme" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="ModeTitle" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                  <CheckBox x:Name="ChangeApps"/>
                  <CheckBox x:Name="ChangeSystem"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="AccentTitle" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="AccentHint" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                  <CheckBox x:Name="ApplyAccent"/>
                  <CheckBox x:Name="AccentOnChrome"/>
                  <TextBlock x:Name="PresetsLabel" Margin="0,10,0,8" Foreground="{DynamicResource Muted}"/>
                  <WrapPanel x:Name="PresetPanel"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border x:Name="AccentPreview" Width="42" Height="42" CornerRadius="12"
                            BorderBrush="{DynamicResource SwatchBorder}" BorderThickness="1" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="AccentLabel" Foreground="{DynamicResource Text}"/>
                      <TextBox x:Name="AccentBox" Width="140" Margin="0,6,0,0" TextChanged="AccentBox_OnTextChanged"/>
                    </StackPanel>
                    <Button x:Name="PickerButton" Style="{StaticResource GhostButton}"
                            Margin="12,18,0,0" VerticalAlignment="Bottom" Click="Picker_OnClick"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="GammaEnabled"/>
                  <TextBlock x:Name="ContrastLabel" Foreground="{DynamicResource Text}"/>
                  <Slider x:Name="ContrastSlider" Minimum="0.7" Maximum="1.4" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  <TextBlock x:Name="BrightnessLabel" Foreground="{DynamicResource Text}"/>
                  <Slider x:Name="BrightnessSlider" Minimum="-0.2" Maximum="0.2" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  <TextBlock x:Name="GammaLabel" Foreground="{DynamicResource Text}"/>
                  <Slider x:Name="GammaSlider" Minimum="0.7" Maximum="1.4" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="PresetNeutral" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="PresetNeutral_OnClick"/>
                    <Button x:Name="PresetComfort" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="PresetComfort_OnClick"/>
                    <Button x:Name="PresetCrisp" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="PresetCrisp_OnClick"/>
                    <Button x:Name="ResetGamma" Style="{StaticResource GhostButton}" Click="ResetGamma_OnClick"/>
                  </StackPanel>
                  <TextBlock x:Name="GammaHint" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="CabcSection" Style="{StaticResource SectionTitle}"/>
                  <CheckBox x:Name="ManageCabc"/>
                  <TextBlock x:Name="CabcModeLabel" Margin="0,6,0,4" Foreground="{DynamicResource Text}"/>
                  <ComboBox x:Name="CabcModeBox" Width="240" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="CabcHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ApplyCabcButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ApplyCabc_OnClick"/>
                    <Button x:Name="OpenDisplaySettingsButton" Style="{StaticResource GhostButton}" Click="OpenDisplaySettings_OnClick"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="LanguageLabel" Margin="0,0,0,6" Foreground="{DynamicResource Text}"/>
                  <ComboBox x:Name="LanguageBox" Width="260" HorizontalAlignment="Left"/>
                  <CheckBox x:Name="StartWithWindows"/>
                  <CheckBox x:Name="StartMinimized"/>
                  <TextBlock x:Name="PortableHint" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="AboutTitle" Style="{StaticResource SectionTitle}"/>
                  <TextBlock x:Name="AboutBody" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                  <TextBlock x:Name="AboutLite" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                  <TextBlock x:Name="AboutOss" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                  <TextBlock x:Name="AboutRepo" Foreground="{DynamicResource Accent}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                  <TextBlock x:Name="AboutLicense" Style="{StaticResource Hint}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
