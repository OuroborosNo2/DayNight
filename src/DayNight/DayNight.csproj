<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\DayNight.ico</ApplicationIcon>
    <AssemblyName>DayNight</AssemblyName>
    <RootNamespace>DayNight</RootNamespace>
    <Version>1.0.0</Version>
    <Product>DayNight</Product>
    <Company>DayNight</Company>
    <Authors>DayNight Contributors</Authors>
    <Description>Portable Windows theme scheduler and display comfort toolkit.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DayNight.Core\DayNight.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DayNight.ico" />
    <Resource Include="Assets\preview.png" />
  </ItemGroup>
</Project>
